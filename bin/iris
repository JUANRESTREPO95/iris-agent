#!/usr/bin/env bash
# Iris Agent — utilidad de gestión.
#
#   iris status
#   iris logs [core|bridge|ollama]
#   iris pair
#   iris model [nombre]
#   iris restart
#   iris update
#   iris doctor
#   iris uninstall [--purge]

set -Eeuo pipefail

ENV_FILE=/etc/iris/iris.env
APP_DIR=/opt/iris
IRIS_USER=iris

die() { printf '\033[1;31m[error]\033[0m %s\n' "$*" >&2; exit 1; }
info() { printf '\033[1;36m[iris]\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m[aviso]\033[0m %s\n' "$*"; }

as_root() {
  if [[ $EUID -eq 0 ]]; then "$@"; else sudo "$@"; fi
}

as_iris() {
  if [[ $EUID -eq 0 ]]; then
    runuser -u "$IRIS_USER" -- env HOME="/home/$IRIS_USER" "$@"
  else
    sudo -u "$IRIS_USER" -H "$@"
  fi
}

load_env() {
  [[ -f $ENV_FILE ]] || die "No hay instalación ($ENV_FILE)."
  # shellcheck disable=SC1090
  set -a; . "$ENV_FILE"; set +a
}

svc_state() { systemctl is-active "$1" 2>/dev/null || true; }

cmd_status() {
  load_env
  local units=(iris-core)
  if [[ -f /etc/systemd/system/iris-bridge.service ]]; then
    units=(iris-bridge "${units[@]}")
  fi
  if [[ -f /etc/systemd/system/iris-telegram.service ]]; then
    units=(iris-telegram "${units[@]}")
  fi
  if [[ -f /etc/systemd/system/iris-ollama.service ]]; then
    units=(iris-ollama "${units[@]}")
  fi
  echo "Canales: ${IRIS_CHANNELS:-whatsapp} · proveedor ${IRIS_PROVIDER:-?}${IRIS_MODEL:+ · modelo $IRIS_MODEL}"
  echo "Servicios:"
  for svc in "${units[@]}"; do
    printf '  %-14s %s\n' "$svc" "$(svc_state "$svc")"
  done
  local core_json bridge_json
  echo
  echo "Salud del núcleo:"
  core_json="$(curl -fsS -m 3 "http://127.0.0.1:${IRIS_CORE_PORT}/health" 2>/dev/null || true)"
  if [[ -n $core_json ]]; then
    printf '%s' "$core_json" | python3 -m json.tool
  else
    echo "  (sin respuesta en 127.0.0.1:${IRIS_CORE_PORT})"
  fi
  if [[ -f /etc/systemd/system/iris-bridge.service ]]; then
    echo
    echo "WhatsApp:"
    bridge_json="$(curl -fsS -m 3 "http://127.0.0.1:${IRIS_BRIDGE_PORT}/health" 2>/dev/null || true)"
    if [[ -n $bridge_json ]]; then
      printf '%s' "$bridge_json" | python3 -m json.tool
    else
      echo "  (sin respuesta en 127.0.0.1:${IRIS_BRIDGE_PORT})"
    fi
  fi
  if [[ -f /etc/systemd/system/iris-telegram.service ]]; then
    echo
    echo "Telegram:"
    tg_json="$(curl -fsS -m 3 "${IRIS_TELEGRAM_BRIDGE_URL:-http://127.0.0.1:3005}/health" 2>/dev/null || true)"
    if [[ -n $tg_json ]]; then
      printf '%s' "$tg_json" | python3 -m json.tool
    else
      echo "  (sin respuesta en ${IRIS_TELEGRAM_BRIDGE_URL:-http://127.0.0.1:3005})"
    fi
  fi
}

cmd_logs() {
  local which="${1:-core}"
  if [[ $which == install ]]; then
    local log=/var/log/iris/install.log
    [[ -f $log ]] || die "No hay log de instalación ($log)."
    as_root tail -n 120 -f "$log"
    return
  fi
  as_root journalctl -u "iris-${which}" -n 120 -f
}

cmd_pair() {
  load_env
  if [[ ! -f /etc/systemd/system/iris-bridge.service ]]; then
    die "WhatsApp no está configurado en esta instalación."
  fi
  info "Deteniendo el puente para parear…"
  as_root systemctl stop iris-bridge.service 2>/dev/null || true

  # Una sesión cerrada o inválida impide que aparezca el QR: se aparta la anterior.
  local session="${IRIS_WA_SESSION:-/var/lib/iris/whatsapp-session}"
  if [[ -e $session ]]; then
    local stamp; stamp="$(date +%Y%m%d-%H%M%S)"
    info "Guardando la sesión anterior en ${session}.bak.${stamp}"
    as_root mv "$session" "${session}.bak.${stamp}"
  fi
  as_iris mkdir -p "$session"

  info "Escanea el QR con WhatsApp (Dispositivos vinculados)."
  as_iris bash -c ". '$ENV_FILE'; exec /usr/bin/env node '$APP_DIR/bridge/server.js' --pair" </dev/tty || true
  info "Reiniciando el puente…"
  as_root systemctl start iris-bridge.service
  sleep 2
  curl -fsS -m 3 "http://127.0.0.1:${IRIS_BRIDGE_PORT}/health" 2>/dev/null || true
  echo
}

cmd_telegram() {
  load_env
  [[ $EUID -eq 0 ]] || die "Ejecuta con sudo:  sudo iris telegram"
  local token="${1:-}" user="${2:-}" bot=""
  if [[ -z $token ]]; then
    read -rsp "Token del bot de Telegram (@BotFather): " token </dev/tty
    echo
  fi
  [[ -n $token ]] || die "Token vacío."
  bot="$(curl -fsS --max-time 15 "https://api.telegram.org/bot${token}/getMe" 2>/dev/null \
    | sed -n 's/.*"username"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -n1)"
  [[ -n $bot ]] || die "Telegram rechazó el token."
  if [[ -z $user ]]; then
    read -rp "Tu ID numérico de Telegram (usa @userinfobot): " user </dev/tty
  fi
  [[ $user == "*" || $user =~ ^-?[0-9]+$ ]] || die "ID de Telegram no válido."

  local port="${IRIS_TELEGRAM_BRIDGE_PORT:-}"
  if [[ -z $port ]]; then
    port=3005
    while ss -ltnH "sport = :$port" 2>/dev/null | grep -q .; do
      port=$((port + 1))
    done
  fi

  local channels="telegram"
  if [[ -f /etc/systemd/system/iris-bridge.service ]]; then
    channels="both"
  fi

  if [[ ! -f /opt/iris/telegram/bot.py ]]; then
    info "Actualizando Iris para incluir el puente de Telegram…"
    as_root bash "$APP_DIR/install.sh" --update
  fi

  TOKEN="$token" USER_ID="$user" TG_PORT="$port" CHANNELS="$channels" python3 - <<'PY'
import os
from pathlib import Path

path = Path("/etc/iris/iris.env")
lines = [
    line for line in path.read_text(encoding="utf-8").splitlines()
    if not line.startswith(("IRIS_TELEGRAM_", "IRIS_CHANNELS="))
]
lines += [
    f"IRIS_CHANNELS={os.environ['CHANNELS']}",
    f"IRIS_TELEGRAM_TOKEN={os.environ['TOKEN']}",
    f"IRIS_TELEGRAM_USER={os.environ['USER_ID']}",
    f"IRIS_TELEGRAM_BRIDGE_PORT={os.environ['TG_PORT']}",
    f"IRIS_TELEGRAM_BRIDGE_URL=http://127.0.0.1:{os.environ['TG_PORT']}",
]
path.write_text("\n".join(lines) + "\n", encoding="utf-8")
path.chmod(0o640)
PY
  chown root:"$IRIS_USER" /etc/iris/iris.env

  install -m 0644 /opt/iris/systemd/iris-telegram.service /etc/systemd/system/iris-telegram.service
  systemctl daemon-reload
  systemctl enable iris-telegram.service >/dev/null
  systemctl restart iris-telegram.service iris-core.service
  sleep 2

  ok "Telegram configurado: @$bot · canales: $channels"
  dim "Abre @$bot en Telegram y pulsa /start."
  if [[ $user != "*" ]] && curl -fsS -X POST "http://127.0.0.1:${port}/send" \
      -H "Authorization: Bearer $IRIS_BRIDGE_TOKEN" \
      -H 'Content-Type: application/json' \
      -d "{\"chatId\":\"$user\",\"text\":\"Iris en línea ✅\"}" >/dev/null 2>&1; then
    ok "Mensaje de prueba enviado por Telegram"
  else
    warn "Aún no puedo escribirte por Telegram: abre @$bot y pulsa /start."
  fi
}

cmd_model() {
  load_env
  if [[ $# -eq 0 ]]; then
    echo "Modelo actual: $IRIS_MODEL"
    return
  fi
  local model="$1"
  [[ -n $model ]] || die "Indica el nombre del modelo."
  [[ $model =~ ^[A-Za-z0-9._:/+-]+$ ]] || die "Nombre de modelo no válido."
  info "Verificando $model…"
  as_iris ollama pull "$model" >/dev/null 2>&1 || warn "No pude descargar '$model'; se intentará al usarlo."
  info "Cambiando a $model…"
  as_root sed -i "s|^IRIS_MODEL=.*|IRIS_MODEL=${model}|" "$ENV_FILE"
  as_root systemctl restart iris-core.service
  info "Listo. Modelo: $model"
}

cmd_restart() {
  info "Reiniciando servicios…"
  local units=(iris-core.service)
  if [[ -f /etc/systemd/system/iris-bridge.service ]]; then
    units=(iris-bridge.service "${units[@]}")
  fi
  if [[ -f /etc/systemd/system/iris-telegram.service ]]; then
    units=(iris-telegram.service "${units[@]}")
  fi
  if [[ -f /etc/systemd/system/iris-ollama.service ]]; then
    units=(iris-ollama.service "${units[@]}")
  fi
  as_root systemctl restart "${units[@]}"
  sleep 2
  cmd_status
}

cmd_update() {
  load_env
  local src="${IRIS_SOURCE_DIR:-}"
  if [[ -n $src && -f "$src/install.sh" ]]; then
    info "Actualizando desde $src…"
    as_root bash "$src/install.sh" --update
  elif [[ -n ${IRIS_REPO_URL:-} ]]; then
    info "Actualizando desde ${IRIS_REPO_URL}…"
    as_root bash -c "curl -fsSL '${IRIS_REPO_URL%/}/raw/${IRIS_REPO_REF:-main}/install.sh' | bash -s -- --update"
  else
    info "Actualizando desde la copia instalada…"
    as_root bash "$APP_DIR/install.sh" --update
  fi
}

cmd_doctor() {
  load_env
  echo "Iris doctor"
  echo "-----------"
  printf 'Sistema:        %s\n' "$(uname -sr)"
  printf 'Node:           %s\n' "$(node -v 2>/dev/null || echo 'no encontrado')"
  printf 'Claude Code:    %s\n' "$(claude --version 2>/dev/null | head -n1 || echo 'no encontrado')"
  printf 'Ollama:         %s\n' "$(ollama --version 2>/dev/null | head -n1 || echo 'no instalado')"
  printf 'Canales:        %s\n' "${IRIS_CHANNELS:-whatsapp}"
  printf 'Proveedor:      %s\n' "${IRIS_PROVIDER:-?}"
  printf 'Modelo config.: %s\n' "${IRIS_MODEL:-(predeterminado del proveedor)}"
  printf 'Disco libre:    %s\n' "$(df -h / | awk 'NR==2 {print $4}')"
  printf 'Memoria libre:  %s\n' "$(free -h | awk '/^Mem:/ {print $7}')"
  echo
  if [[ -r /etc/iris/install-state.json ]]; then
    echo "Instalación:"
    python3 - /etc/iris/install-state.json <<'PY'
import json, sys
try:
    d = json.load(open(sys.argv[1]))
except Exception as exc:
    print(f"  (recibo ilegible: {exc})")
    raise SystemExit(0)
detail = d.get("detail", "")
print(f"  resultado:  {d.get('outcome', '?')}{' — ' + detail if detail else ''}")
print(f"  fecha:      {d.get('updated_at', '?')}")
print(f"  modelo:     {d.get('model', '?')}")
print(f"  origen:     {d.get('source', '?')}")
ports = d.get("ports") or {}
print(f"  puertos:    bridge {ports.get('bridge')} / core {ports.get('core')}")
print(f"  log:        {d.get('log', '?')}")
PY
  else
    echo "Instalación: (sin recibo)"
  fi
  echo
  if [[ ${IRIS_PROVIDER:-} == ollama-local ]]; then
    printf 'Ollama API:     '; curl -fsS -m 3 http://127.0.0.1:11434/api/tags >/dev/null && echo OK || echo FALLA
  fi
  printf 'Núcleo:         '; curl -fsS -m 3 "http://127.0.0.1:${IRIS_CORE_PORT}/health" >/dev/null && echo OK || echo FALLA
  if [[ -f /etc/systemd/system/iris-bridge.service ]]; then
    printf 'WhatsApp:       '; curl -fsS -m 3 "http://127.0.0.1:${IRIS_BRIDGE_PORT}/health" >/dev/null && echo OK || echo FALLA
  fi
  if [[ -f /etc/systemd/system/iris-telegram.service ]]; then
    printf 'Telegram:       '; curl -fsS -m 3 "${IRIS_TELEGRAM_BRIDGE_URL:-http://127.0.0.1:3005}/health" >/dev/null && echo OK || echo FALLA
  fi
  echo
  local units=(iris-core)
  if [[ -f /etc/systemd/system/iris-bridge.service ]]; then
    units=(iris-bridge "${units[@]}")
  fi
  if [[ -f /etc/systemd/system/iris-telegram.service ]]; then
    units=(iris-telegram "${units[@]}")
  fi
  if [[ -f /etc/systemd/system/iris-ollama.service ]]; then
    units=(iris-ollama "${units[@]}")
  fi
  for svc in "${units[@]}"; do
    printf '%-14s %s\n' "$svc" "$(svc_state "$svc")"
  done
  echo
  echo "Últimas líneas del núcleo:"
  as_root journalctl -u iris-core -n 8 --no-pager 2>/dev/null || true
}

cmd_uninstall() {
  local installer="$APP_DIR/install.sh"
  if [[ -f $ENV_FILE ]]; then
    # shellcheck disable=SC1090
    local src; src="$(sed -n 's/^IRIS_SOURCE_DIR=//p' "$ENV_FILE" | head -n1)"
    [[ -n ${src:-} && -f "$src/install.sh" ]] && installer="$src/install.sh"
  fi
  as_root bash "$installer" --uninstall "$@"
}

usage() {
  cat <<'EOF'
Uso: iris <comando>

  status                 estado de servicios y salud
  logs [core|bridge|ollama|install]   seguir logs
  pair                   volver a parear WhatsApp
  telegram [token] [id]  añadir o actualizar el bot de Telegram
  model [nombre]         ver o cambiar el modelo
  restart                reiniciar todo
  update                 actualizar desde el instalador
  doctor                 diagnóstico rápido
  uninstall [--purge]    quitar servicios (y purga con --purge)
EOF
}

case "${1:-}" in
  status) shift; cmd_status "$@" ;;
  logs) shift; cmd_logs "$@" ;;
  pair) shift; cmd_pair "$@" ;;
  telegram) shift; cmd_telegram "$@" ;;
  model) shift; cmd_model "$@" ;;
  restart) shift; cmd_restart "$@" ;;
  update) shift; cmd_update "$@" ;;
  doctor) shift; cmd_doctor "$@" ;;
  uninstall) shift; cmd_uninstall "$@" ;;
  help|--help|-h|"") usage ;;
  *) die "Comando desconocido: $1 (usa: iris help)" ;;
esac
