# Iris Agent — configuración para Docker.
# Copia a .env y edita. El instalador también genera este archivo.

# Canales: telegram | whatsapp | both
IRIS_CHANNELS=telegram
IRIS_PHONE=
IRIS_TELEGRAM_TOKEN=
IRIS_TELEGRAM_USER=

# Proveedor: ollama-local | claude-subscription | claude-api | custom
IRIS_PROVIDER=ollama-local
IRIS_MODEL=deepseek-v4.1-flash:cloud

# Token interno entre el núcleo y los puentes (obligatorio).
# Genera uno con: openssl rand -hex 32
IRIS_BRIDGE_TOKEN=

# Envío de documentos desde el agente (marcador [[ADJUNTO:/ruta]]).
# El núcleo copia el archivo a esta carpeta, compartida con los puentes.
# Por defecto: $IRIS_DATA/outbox (en Docker, /var/lib/iris/outbox).
IRIS_OUTBOX=
# Tamaño máximo por archivo en MB (Telegram siempre corta en 50).
IRIS_MAX_FILE_MB=100

# Memoria en Notas (opcional).
# Varias URLs separadas por comas, en orden de preferencia. Si una no responde,
# Iris prueba la siguiente (útil con dominio público + red interna de Coolify).
# NOTAS_API_URLS=https://txt.jpra1995.cloud,http://host.docker.internal:3001
NOTAS_API_URL=
NOTAS_API_URLS=
NOTAS_API_TOKEN=
# manual (solo /guardar) o auto (guarda cada intercambio)
IRIS_MEMORY_MODE=manual
# Recordatorios de Notas (solo Iris)
IRIS_REMINDERS=off
IRIS_REMINDER_INTERVAL=60
# telegram | whatsapp | auto
IRIS_REMINDER_CHANNEL=auto
IRIS_TIMEZONE=America/Bogota
# IRIS_NOTAS_TTL=60

# Corta la sesión de Claude Code cada N horas (0 = nunca). No avisa al usuario.
IRIS_SESSION_MAX_HOURS=12
# Al empezar una sesión nueva, añade los últimos N caracteres de conversacion.md
# para no perder el hilo reciente (0 = no añadir nada).
IRIS_SESSION_TAIL_CHARS=4000
# Actualiza contexto.md en segundo plano cada N horas (0 = desactivado).
# No avisa por el chat. Solo el proyecto activo de cada chat con actividad.
IRIS_AUTOSAVE_HOURS=6

# Avisos de correo nuevo de Gmail (opcional). Requiere contraseña de aplicación
# (la cuenta debe tener 2FA). Si no pones la contraseña aquí, se lee de
# ~/.config/iris/mail-app-password con permisos 600.
IRIS_MAIL=off
IRIS_MAIL_USER=
IRIS_MAIL_APP_PASSWORD=
IRIS_MAIL_INTERVAL=60
# telegram | whatsapp | auto
IRIS_MAIL_CHANNEL=auto
IRIS_MAIL_FOLDER=INBOX
# Horario sin avisos, hora local. Ejemplo: 23:00-07:00
IRIS_MAIL_QUIET=
IRIS_MAIL_MAX_PER_TICK=5

# Transcripción de notas de voz (Telegram y WhatsApp) con faster-whisper local.
# Modelos: tiny, base, small, medium, large-v3. base va bien en CPU.
IRIS_TRANSCRIBE=off
IRIS_TRANSCRIBE_MODEL=base
IRIS_TRANSCRIBE_LANG=es

# Credenciales del proveedor. Deja solo las que correspondan.
# Ollama en el compose (ollama-local):
ANTHROPIC_BASE_URL=http://iris-ollama:11434
ANTHROPIC_AUTH_TOKEN=ollama
# Claude con suscripción:
# CLAUDE_CODE_OAUTH_TOKEN=
# Claude con clave de API:
# ANTHROPIC_API_KEY=
# Otro endpoint compatible con Anthropic:
# ANTHROPIC_BASE_URL=
# ANTHROPIC_AUTH_TOKEN=
